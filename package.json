{
  "name": "@ug.software/opposer",
  "version": "3.0.13",
  "description": "Ecossistema modular para construção de aplicações modernas focado em alta produtividade e organização por Domínios.",
  "type": "module",
  "module": "./lib/esm/index.js",
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "bin": {
    "opposer": "./lib/bin/opposer.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://www.opposer.uiaranguilherme.com"
  },
  "keywords": [
    "orm",
    "scheduler",
    "http-server",
    "modular",
    "typescript",
    "opposer",
    "backend",
    "framework"
  ],
  "author": "UG Software",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ug-software/opposer/issues"
  },
  "homepage": "https://github.com/ug-software/opposer#readme",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "default": "./lib/esm/index.js"
    },
    "./orm": {
      "types": "./lib/esm/orm/index.d.ts",
      "default": "./lib/esm/orm/index.js"
    },
    "./persistent": {
      "types": "./lib/esm/persistent/index.d.ts",
      "default": "./lib/esm/persistent/index.js"
    },
    "./playground": {
      "types": "./lib/esm/playground/index.d.ts",
      "default": "./lib/esm/playground/index.js"
    },
    "./scheduler": {
      "types": "./lib/esm/scheduler/index.d.ts",
      "default": "./lib/esm/scheduler/index.js"
    },
    "./server": {
      "types": "./lib/esm/server/index.d.ts",
      "default": "./lib/esm/server/index.js"
    },
    "./system": {
      "types": "./lib/esm/system/index.d.ts",
      "default": "./lib/esm/system/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "mysql2": "^3.12.0",
    "pg": "^8.13.3",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
