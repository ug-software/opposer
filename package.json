{
    "name": "opposer",
    "version": "1.0.0",
    "type": "module",
    "main": "./lib/cjs/index.cjs",
    "module": "./lib/esm/index.js",
    "types": "./lib/esm/index.d.ts",
    "bin": {
        "opposer": "./lib/bin/opposer.js"
    },
    "exports": {
        ".": {
            "import": "./lib/esm/index.js",
            "require": "./lib/cjs/index.js"
        },
        "./orm": {
            "import": "./lib/esm/orm/index.js",
            "require": "./lib/cjs/orm/index.js"
        },
        "./persistent": {
            "import": "./lib/esm/persistent/index.js",
            "require": "./lib/cjs/persistent/index.js"
        },
        "./playground": {
            "import": "./lib/esm/playground/index.js",
            "require": "./lib/cjs/playground/index.js"
        },
        "./server": {
            "import": "./lib/esm/server/index.js",
            "require": "./lib/cjs/server/index.js"
        },
        "./system": {
            "import": "./lib/esm/system/index.js",
            "require": "./lib/cjs/system/index.js"
        }
    },
    "scripts": {
        "build": "gulp build",
        "release": "RELEASE=1.0.4 DESC='Latest version' npx gulp release"
    },
    "files": [
        "lib"
    ],
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "merge-stream": "^2.0.0",
        "node-cron": "^4.2.1",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.5",
        "@types/gulp": "^4.0.17",
        "@types/node": "^22.13.14",
        "@types/node-cron": "^3.0.11",
        "del": "^8.0.1",
        "gulp": "^5.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "pg": "^8.14.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
