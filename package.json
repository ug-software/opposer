{
    "name": "opposer",
    "version": "1.1.2",
    "type": "module",
    "main": "./lib/cjs/index.cjs",
    "module": "./lib/esm/index.js",
    "types": "./lib/esm/index.d.ts",
    "bin": {
        "opposer": "./lib/bin/opposer.js"
    },
    "exports": {
        ".": {
            "import": "./lib/esm/index.js",
            "require": "./lib/cjs/index.js"
        }
    },
    "scripts": {
        "build": "gulp build",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "release": "RELEASE=1.0.4 DESC='Latest version' npx gulp release",
        "preview": "npx tsx src/_test/index.ts"
    },
    "files": [
        "lib"
    ],
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/gulp": "^4.0.17",
        "@types/node": "^22.13.14",
        "del": "^8.0.1",
        "gulp": "^5.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "pg": "^8.14.1",
        "typescript": "^5.8.2"
    }
}
