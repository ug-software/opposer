{
    "name": "opposer",
    "description": "Opposer é um ecosistema gerenciador em formato de api, para gestão de dados, criação de metodos capazes de tranformar dados em formato Handler. Desenvolvido para ser rápido em solucionar o acesso e manutenção de dados, seja em inserção, deleção, consulta, páginado ou não ao banco.",
    "version": "1.0.0",
    "author": {
        "name": "Uiaran Guilherme Campos de Lima",
        "email": "uiaran@hotmail.com",
        "url": "https://ui-dev.com"
    },
    "type": "module",
    "main": "./lib/cjs/index.cjs",
    "module": "./lib/esm/index.js",
    "types": "./lib/esm/index.d.ts",
    "bin": {
        "opposer": "./lib/bin/opposer.js"
    },
    "exports": {
        ".": {
            "import": "./lib/esm/index.js",
            "require": "./lib/cjs/index.js"
        }
    },
    "scripts": {
        "build": "gulp build",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:cjs": "tsc -p tsconfig.cjs.json"
    },
    "files": [
        "lib"
    ],
    "dependencies": {
        "express": "^4.21.2",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/gulp": "^4.0.17",
        "@types/node": "^22.13.14",
        "typescript": "^5.8.2",
        "pg": "^8.14.1",
        "cors": "^2.8.5",
        "del": "^8.0.1",
        "gulp": "^5.0.1",
        "gulp-typescript": "^6.0.0-alpha.1"
    }
}
