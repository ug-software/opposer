{
  "name": "@ug.software/opposer",
  "version": "3.0.15",
  "description": "Ecossistema modular para construção de aplicações modernas focado em alta produtividade e organização por Domínios.",
  "type": "module",
  "module": "./lib/esm/index.js",
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "bin": {
    "opposer": "./lib/bin/opposer.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://www.opposer.uiaranguilherme.com"
  },
  "keywords": [
    "orm",
    "scheduler",
    "http-server",
    "modular",
    "typescript",
    "opposer",
    "backend",
    "framework"
  ],
  "author": "UG Software",
  "license": "MIT",
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/ug-software/opposer/issues"
  },
  "homepage": "https://github.com/ug-software/opposer#readme",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "default": "./lib/esm/index.js"
    },
    "./orm": {
      "types": "./lib/esm/orm/index.d.ts",
      "default": "./lib/esm/orm/index.js"
    },
    "./persistent": {
      "types": "./lib/esm/persistent/index.d.ts",
      "default": "./lib/esm/persistent/index.js"
    },
    "./playground": {
      "types": "./lib/esm/playground/index.d.ts",
      "default": "./lib/esm/playground/index.js"
    },
    "./scheduler": {
      "types": "./lib/esm/scheduler/index.d.ts",
      "default": "./lib/esm/scheduler/index.js"
    },
    "./server": {
      "types": "./lib/esm/server/index.d.ts",
      "default": "./lib/esm/server/index.js"
    },
    "./system": {
      "types": "./lib/esm/system/index.d.ts",
      "default": "./lib/esm/system/index.js"
    },
    "./transports": {
      "types": "./lib/esm/transports/index.d.ts",
      "default": "./lib/esm/transports/index.js"
    },
    "./drivers/postgres": {
      "types": "./lib/esm/orm/driver/postgres.d.ts",
      "default": "./lib/esm/orm/driver/postgres.js"
    },
    "./drivers/mysql": {
      "types": "./lib/esm/orm/driver/mysql.d.ts",
      "default": "./lib/esm/orm/driver/mysql.js"
    },
    "./drivers/sqlite": {
      "types": "./lib/esm/orm/driver/sqlite.d.ts",
      "default": "./lib/esm/orm/driver/sqlite.js"
    }
  },
  "scripts": {
    "build": "gulp build",
    "release": "RELEASE=3.0.15 DESC='Modular transports and lean build' npx gulp release",
    "full-app": "npx tsx ./src/examples/full-app/index.ts",
    "build:playground": "gulp buildWithPlayground",
    "test": "vitest run"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "mysql2": "^3.12.0",
    "pg": "^8.13.3",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/gulp": "^4.0.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@types/yargs": "^17.0.33",
    "del": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-typescript": "^6.0.0-alpha.1",
    "jest": "^30.2.0",
    "merge-stream": "^2.0.0",
    "mysql2": "^3.12.0",
    "pg": "^8.14.1",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.0.7"
  }
}
